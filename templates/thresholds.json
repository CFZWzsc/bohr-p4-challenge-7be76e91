      "hour": 1.0,
      "d": 24.0,
      "day": 24.0,
      "wk": 168.0,
      "week": 168.0
    },
    "money_scale": {
      "CNY": 1.0,
      "RMB": 1.0,
      "USD": 1.0,
      "EUR": 1.0,
      "GBP": 1.0,
      "CNY_10K": 10000.0
